<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<Version>1.0.0</Version>
		<PackageId>CSharp.Database.Extension.Testing</PackageId>
        <RootNamespace>CSharp_Database_Extension_Testing</RootNamespace>
		
        <TargetFramework>net10.0</TargetFramework>
		<Authors>Renato Urrea</Authors>
		<Company>Cosmos (CSM)</Company>
		<RepositoryUrl>https://github.com/Cosmos-CSM/csm_database</RepositoryUrl>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageReadmeFile>CHANGELOG.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
		<IsTestProject>false</IsTestProject>
		<OutputType>Exe</OutputType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="CHANGELOG.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="3.2.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\CSharp Database Extension\CSharp Database Extension.csproj" />
	</ItemGroup>

</Project>
